      "False\n"
     ]
    }
   ],
   "source": [
    "nums = [1, 2, 4, 5,32,22,32, 6, 2, 78]\n",
    "n = len(nums)\n",
    "\n",
    "for i in range(0, n - 1):\n",
    "    if nums[i] > nums[i + 1]:\n",
    "        print(False)\n",
    "        break\n",
    "else:\n",
    "    print(True)"
   ]
  },
